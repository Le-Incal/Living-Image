# Living Image Crossfade Test Harness
# Copy this to .env and fill in your API keys

# Google Gemini API (for Nano Banana 2.1 and Pro)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API (for GPT Image 2.5)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Enables the unlinked /admin run-metrics page (any long random string)
ADMIN_TOKEN=

# Where runs and images are stored. On Railway, mount a volume at /data and
# set this to /data/generated_images so they survive redeploys.
GENERATED_DIR=
